# TrailBase config for price_hunter.
#
# Copy this into <traildepot>/config.textproto (see scripts/setup_trailbase.sh).
# Exposes the captures/products tables as Record APIs for the app:
#   GET/POST /api/records/v1/captures
#   GET/POST /api/records/v1/products

email {}
server {
  application_name: "Price Hunter"
  site_url: "http://localhost:4000"
}
auth {}
jobs {}

record_apis: [
  {
    name: "captures"
    table_name: "captures"
    conflict_resolution: REPLACE
    acl_world: [READ]
    acl_authenticated: [READ, CREATE]
  },
  {
    name: "products"
    table_name: "products"
    conflict_resolution: REPLACE
    acl_world: [READ]
    acl_authenticated: [READ, CREATE]
  }
]
